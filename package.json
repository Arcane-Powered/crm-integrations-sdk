{
  "name": "@arcanepowered/integrations-sdk",
  "version": "0.1.0",
  "description": "Define third-party API integrations in one file: typed connection fields, auth, operations and an SSRF-guarded HTTP client.",
  "license": "Apache-2.0",
  "author": "Arcane Powered",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Arcane-Powered/crm-integrations-sdk.git"
  },
  "homepage": "https://github.com/Arcane-Powered/crm-integrations-sdk#readme",
  "bugs": "https://github.com/Arcane-Powered/crm-integrations-sdk/issues",
  "keywords": [
    "integrations",
    "connectors",
    "api",
    "ssrf",
    "zod",
    "workflow"
  ],
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "packageManager": "pnpm@10.26.2",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./node": {
      "types": "./dist/node.d.ts",
      "import": "./dist/node.js",
      "default": "./dist/node.js"
    },
    "./testing": {
      "types": "./dist/testing.d.ts",
      "import": "./dist/testing.js",
      "default": "./dist/testing.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "LICENSE",
    "README.md"
  ],
  "sideEffects": false,
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "test": "vitest run",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "changeset": "changeset",
    "release": "pnpm build && changeset publish"
  },
  "peerDependencies": {
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@changesets/cli": "^2.29.7",
    "@types/node": "26.6.2",
    "typescript": "6.0.3",
    "vitest": "5.0.1",
    "zod": "^4.6.5"
  }
}
